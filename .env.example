# Copy to .env locally. Never commit the resulting file or paste credentials into chat.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000

# Disabled until ALL services and keys are configured. The email-draft fallback stays usable.
CONTACT_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
# Verify a sending subdomain with Resend first; this is a proposed sender, not an existing mailbox.
CONTACT_FROM=portfolio@contact.eklavyagogia.me
CONTACT_TO=ext.eklavya@gmail.com

# Generate two separate random values with: openssl rand -hex 32
RATE_LIMIT_SECRET=
REDIS_PASSWORD=
# For local Redis. Use a private network or rediss:// for managed Redis over a public network.
REDIS_URL=redis://127.0.0.1:6379

# Leave empty when connecting directly. Configure only actual reverse-proxy IPs/CIDRs.
# Never use a hop count, true, or a global address range.
TRUST_PROXY_CIDRS=

# Vercel production uses APP_ORIGIN=https://www.eklavyagogia.me and does not use
# TRUST_PROXY_CIDRS. Add every production value in Vercel's Environment Variables.
